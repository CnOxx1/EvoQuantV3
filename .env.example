# EvoQuant 环境变量配置
# 复制此文件为 .env 并按需修改

# ─── 数据库 ──────────────────────────────────────────────
# 后端类型: sqlite (默认, 开发/测试) | postgres (生产)
DB_BACKEND=postgres
DB_SPLIT_ENABLED=1

# PostgreSQL 连接配置 (仅 DB_BACKEND=postgres 时生效)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=evoquant
PG_USER=evoquant
PG_PASSWORD=evoquant2024
DB_POOL_MIN=5
DB_POOL_MAX=20
PG_SCHEMA_EXCHANGE=exchange_data
PG_SCHEMA_MARKET=market_data
PG_SCHEMA_ANALYTICS=analytics

# ─── 日志 ────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── 交易所 API Key ──────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSWORD=
BYBIT_API_KEY=
BYBIT_SECRET=

# ─── 受控交易所采集（留空时使用完整默认市场宇宙）──────────
# 默认监控 BTC/USDT 与 ETH/USDT；受限网络可只使用 OKX 并控制采集预算。
# EVOQUANT_TARGET_EXCHANGES=okx
# EVOQUANT_TARGET_SYMBOLS=BTC/USDT,ETH/USDT
# EVOQUANT_KLINE_TIMEFRAMES=1m
# MAX_COLLECTION_WORKERS=2
# EXCHANGE_MIN_REQUEST_INTERVAL_MS=150
# LOGIC_PIPELINE_PHASE2_WORKERS=2

# ─── 外部数据源 API Key ──────────────────────────────────
WHALE_ALERT_API_KEY=
LUNARCRUSH_API_KEY=
SANTIMENT_API_KEY=
ARKHAM_API_KEY=
ETHERSCAN_API_KEY=
THE_GRAPH_API_KEY=
# GitHub 补充特征：无令牌时默认关闭；如需匿名访问请显式设置为 1。
GITHUB_TOKEN=
ALTERNATIVE_ENABLE_GITHUB=0

# ─── 代理（解决地域封锁）────────────────────────────────
# 格式: http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
CRYPTO_PROXY_URL=

# ─── API 服务 ────────────────────────────────────────────
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_RATE_LIMIT_MAX_REQUESTS=200
API_RATE_LIMIT_WINDOW_SECONDS=60

# ─── 调度间隔（秒）───────────────────────────────────────
TICKER_INTERVAL_SECONDS=5
FUNDING_INTERVAL_SECONDS=900
ORDERBOOK_INTERVAL_SECONDS=3
NEWS_INTERVAL_SECONDS=300
MACRO_MARKET_INTERVAL_SECONDS=900
MACRO_LEVEL_INTERVAL_SECONDS=86400
EVENT_CALENDAR_INTERVAL_SECONDS=21600
ONCHAIN_EXCHANGE_FLOW_INTERVAL_SECONDS=1800
ONCHAIN_WHALE_ACTIVITY_INTERVAL_SECONDS=1800
ONCHAIN_STABLECOIN_FLOW_INTERVAL_SECONDS=900
EXCHANGE_TRADE_FLOW_INTERVAL_SECONDS=60
EXCHANGE_OPEN_INTEREST_INTERVAL_SECONDS=300
EXCHANGE_BASIS_INTERVAL_SECONDS=300
EXCHANGE_LIQUIDATION_INTERVAL_SECONDS=300
EXCHANGE_POSITIONING_INTERVAL_SECONDS=900
DATA_QUALITY_AUDIT_INTERVAL_SECONDS=300
PERPETUAL_DEX_INTERVAL_SECONDS=900
ONCHAIN_ADDRESS_INTERVAL_SECONDS=600
DEX_LIQUIDITY_INTERVAL_SECONDS=1200
GAS_NETWORK_INTERVAL_SECONDS=300
GOVERNANCE_INTERVAL_SECONDS=1800
LIQUIDATION_CASCADE_INTERVAL_SECONDS=600
CROSS_VENUE_ARB_INTERVAL_SECONDS=300
ONCHAIN_LEAD_LAG_INTERVAL_SECONDS=1800

# ─── 数据保留策略（天）───────────────────────────────────
TICKER_RETENTION_DAYS=30
ORDERBOOK_RETENTION_DAYS=14
FUNDING_RETENTION_DAYS=365
TRADE_FLOW_RETENTION_DAYS=30
# SQLite 连接关闭时进行被动 WAL checkpoint，降低常驻运行的 WAL 累积。
SQLITE_WAL_CHECKPOINT_ON_CLOSE=1
OPEN_INTEREST_RETENTION_DAYS=365
BASIS_RETENTION_DAYS=365
LIQUIDATION_RETENTION_DAYS=90
POSITIONING_RETENTION_DAYS=365

# ─── 路由开关（0=禁用，1=启用）─────────────────────────────
# 以下路由依赖付费 API 或数据源不可用，默认禁用
FF_WHALE_TRACKER_ENABLED=0
FF_WHALE_PNL_ENABLED=0
FF_SOCIAL_SENTIMENT_ENABLED=0
FF_NFT_MARKET_ENABLED=0
FF_DEX_TRADE_FLOW_ENABLED=0
FF_REGULATORY_ENABLED=0
FF_ONCHAIN_ADDRESS_ENABLED=0
FF_DERIVATIVES_SENTIMENT_ENABLED=0
FF_ONCHAIN_HOLDER_ENABLED=0

# ─── 进程管理 ────────────────────────────────────────────
DAEMON_RESTART_BASE_DELAY=2.0
DAEMON_RESTART_MAX_DELAY=60.0
